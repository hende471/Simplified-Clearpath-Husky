# These udev rules give the Husky platform container stable device names.
# The file name must sort after 60-input-id.rules, because the gamepad rule
# matches on ID_INPUT_JOYSTICK, which that file sets.
# Install them on the host with:
#   sudo cp 70-clearpath-husky.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger

# The MCU's Prolific USB-serial adapter appears as /dev/clearpath/prolific.
SUBSYSTEMS=="usb", ATTRS{manufacturer}=="Prolific*", SYMLINK+="clearpath/prolific clearpath/prolific_$attr{devpath}", MODE="0666"

# PS4 and PS5 controllers are made readable, and the PS5 joystick appears as
# /dev/input/ps5.
KERNEL=="uinput", MODE="0666"
KERNEL=="event*", MODE="0666"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="05c4", MODE="0666"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", KERNELS=="*:054C:05C4.*", MODE="0666"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="09cc", MODE="0666"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", KERNELS=="*:054C:09CC.*", MODE="0666"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", KERNELS=="*:054C:0CE6.*", MODE="0666"
KERNEL=="js*", SUBSYSTEM=="input", KERNELS=="*:054C:0CE6.*", MODE="0666"
KERNEL=="js*", SUBSYSTEM=="input", KERNELS=="*:054C:0CE6.*", ENV{ID_INPUT_JOYSTICK}=="1", MODE="0666", SYMLINK+="input/ps5"
